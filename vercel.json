{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/docs/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/docs",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/src/client/$1"
    }
  ]
}
