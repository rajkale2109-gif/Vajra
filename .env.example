# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (PostgreSQL; leave empty or memory:// for embedded PGlite)
DATABASE_URL=postgres://vajra:vajra_secret@localhost:5432/vajra_governance

# Auth & Security
AUTH_SECRET=vajra_super_secret_jwt_key_change_in_production
DEFAULT_ACCOUNT_ID=acme-cooling-in
DEFAULT_USER_ID=u_demo_planner

# Reference & Simulated Date (ISO YYYY-MM-DD; if omitted, defaults to system current date)
SIMULATED_CURRENT_DATE=2026-11-15

# Threshold Defaults (Config-driven)
DEFAULT_MIN_IMPRESSIONS=1000
DEFAULT_CTR_ISSUE_THRESHOLD=-20.0
DEFAULT_CPC_ISSUE_THRESHOLD=30.0
DEFAULT_BUDGET_WARNING_THRESHOLD=0.85
ALERT_COOLDOWN_HOURS=24

# Mailer Driver: 'log' (console log), 'mailhog' (local test inbox), or 'smtp'
MAILER_DRIVER=log
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=governance@vajra.example

# Simulated Platform Connector Injections (Config-driven)
SIMULATE_GOOGLE_DELAY=true
SIMULATE_CAMPAIGN_FAILED_SYNC_ID=27
SIMULATE_CAMPAIGN_DELAYED_SYNC_ID=6
SIMULATE_CAMPAIGN_NO_AD_SETS_ID=26
