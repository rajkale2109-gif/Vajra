# ==========================================
# Vajra Governance - Environment Configuration
# ==========================================

# ------------------------------------------
# 1. Server Configuration
# ------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ------------------------------------------
# 2. Database Configuration
# ------------------------------------------
# PostgreSQL connection string for production / Docker Compose:
# e.g.: postgres://vajra:vajra_secret@localhost:5432/vajra_governance
#
# NOTE: If left empty or omitted, the application automatically uses
# embedded in-process PostgreSQL (PGlite). Zero external database installation needed!
DATABASE_URL=

# ------------------------------------------
# 3. Authentication & Multi-Tenancy
# ------------------------------------------
AUTH_SECRET=vajra_super_secret_jwt_key_change_in_production
DEFAULT_ACCOUNT_ID=acme-cooling-in
DEFAULT_USER_ID=u_demo_planner

# ------------------------------------------
# 4. Reference & Simulation Date
# ------------------------------------------
# Anchors the prototype reporting timeline (ISO YYYY-MM-DD):
SIMULATED_CURRENT_DATE=2026-11-15

# ------------------------------------------
# 5. Config-Driven Quality & Threshold Rules
# ------------------------------------------
# Minimum impressions required in a period before data is deemed reliable
DEFAULT_MIN_IMPRESSIONS=1000

# CTR relative drop % triggering a High severity issue (e.g. -20%)
DEFAULT_CTR_ISSUE_THRESHOLD=-20.0

# CPC relative increase % triggering a Medium severity issue (e.g. +30%)
DEFAULT_CPC_ISSUE_THRESHOLD=30.0

# Campaign budget utilization fraction triggering a pacing warning (e.g. 0.85 = 85%)
DEFAULT_BUDGET_WARNING_THRESHOLD=0.85

# Hours before an alert rule can re-notify on the same continuing breach
ALERT_COOLDOWN_HOURS=24

# ------------------------------------------
# 6. Email / Mailer Driver
# ------------------------------------------
# Options:
#   - 'log': Logs email payload to console and in-memory outbox (simulated)
#   - 'mailhog': Connects to MailHog container (default port 1025)
#   - 'smtp': Sends real emails via an external SMTP relay
MAILER_DRIVER=log
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=governance@vajra.example

# ------------------------------------------
# 7. Simulation Controls (Demo & Testing)
# ------------------------------------------
# Simulate Google Ads platform connector sync delay
SIMULATE_GOOGLE_DELAY=true

# Inject sync failure on specific campaign ID (prototype default: 27)
SIMULATE_CAMPAIGN_FAILED_SYNC_ID=27

# Inject delayed sync on specific campaign ID (prototype default: 6)
SIMULATE_CAMPAIGN_DELAYED_SYNC_ID=6

# Inject zero ad sets configured on specific campaign ID (prototype default: 26)
SIMULATE_CAMPAIGN_NO_AD_SETS_ID=26

# ------------------------------------------
# 8. Real Meta / Google Credentials (Optional)
# ------------------------------------------
# Leave blank to run with simulated connectors.
# If provided, connectors switch to live mode automatically.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
